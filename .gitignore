# ============================================
# FitBuddy - .gitignore
# ============================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.env

# --- Node.js & Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- IDEs & Code Editors ---
# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
slnx.sqlite

# Visual Studio Code
.vscode/

# JetBrains (PyCharm, WebStorm, etc.)
.idea/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/

# --- Large Datasets & Archive Files ---
# Note: Raw image datasets and archives over 100MB cannot be pushed to standard GitHub repos
Dataset/images/
Dataset/*.zip
*.zip
*.tar.gz
*.rar
*.7z

# --- Temporary & Backup Files ---
*.bak
*.tmp
*.temp
*~

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- Logs ---
logs/
*.log
